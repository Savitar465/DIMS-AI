# Copiar a .env y completar. El .env real está en .gitignore.
# Ver docs/base-de-datos.md para el detalle de cada variable.

# ── Base de la aplicación ────────────────────────────────────────────────────
# Facturas, DIMS, caché de clasificaciones y clasificaciones aprendidas.
# TypeORM crea y mantiene estas tablas solo (synchronize).
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=dimsai
DATABASE_USER=
DATABASE_PASSWORD=

# ── Base del Arancel ─────────────────────────────────────────────────────────
# Esquema buscador_arancelario. Se prepara con db/migrations/*.sql; TypeORM NO
# la toca. Es una base distinta de la anterior aunque esté en el mismo servidor:
# Postgres no permite consultar entre bases.
ARANCEL_DB_HOST=
ARANCEL_DB_PORT=5432
ARANCEL_DB_NAME=aranceles
ARANCEL_DB_USER=
ARANCEL_DB_PASSWORD=
# true si el servidor exige TLS (Aiven y la mayoría de los gestionados).
ARANCEL_DB_SSL=true

# ── IA ───────────────────────────────────────────────────────────────────────
# Se usa para extraer datos de las facturas, clasificar subpartidas y generar
# los embeddings del buscador.
GEMINI_API_KEY=

# Llamadas de clasificación en paralelo. Con el plan gratuito de Gemini
# (20 req/min) subirlo solo adelanta el rate limit. Por defecto 3.
LLM_CONCURRENCIA=3

# Ítems que comparten capítulo y viajan en una misma llamada. Las notas legales
# son la mayor parte del prompt y son idénticas dentro de un capítulo, así que
# agrupar baja ~40% los tokens y las llamadas. Por defecto 4.
# Poner 1 vuelve a una llamada por ítem: más caro, pero máxima atención por
# producto. Subirlo mucho abarata más y diluye la atención.
LLM_ITEMS_POR_LLAMADA=4

# ── Servidor ─────────────────────────────────────────────────────────────────
# Puerto HTTP. Por defecto 3001.
PORT=3001
